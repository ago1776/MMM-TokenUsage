[Unit]
Description=Build cache-free AI token data for MMM-TokenUsage

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/MagicMirror/modules/MMM-TokenUsage/collectors/collect.py --timezone Europe/Berlin --output %h/MagicMirror/modules/MMM-TokenUsage/data.json

# Auto-detection reads only ~/.claude and ~/.codex. Add --json/--csv for other feeds.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/MagicMirror/modules/MMM-TokenUsage
