{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ago1776/MMM-TokenUsage/data.schema.json",
  "title": "MMM-TokenUsage data",
  "type": "object",
  "required": ["generated", "claude_daily", "openai_daily"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated": { "type": "string" },
    "days": { "type": "array", "items": { "type": "string" } },
    "claude_daily": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
    "openai_daily": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
    "openai_days": { "type": "array", "items": { "type": "string" } },
    "fallback_days": { "type": "array", "items": { "type": "string" } },
    "counting": {
      "type": "object",
      "properties": {
        "cache": { "enum": ["excluded", "included"] },
        "claude": { "type": "string" },
        "openai": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
